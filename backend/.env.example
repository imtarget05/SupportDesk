# Copy to .env and fill in. NEVER commit the real .env.
# AI provider: "stub" (offline, default) | "cloudflare" (Workers AI) |
#               "openai" | "anthropic" (Claude)
AI_PROVIDER=stub

# Auth: REQUIRED, min 32 chars. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# docker-compose.yml fails fast if JWT_SECRET is unset (no dev default).
# JWT_SECRET=change-me-to-a-32-plus-char-secret

# Guardrail on unsafe AI output: "reject" (return 502, keep ticket) or
# "fallback" (return a neutral draft instead of the blocked one).
# AI_GUARDRAIL_MODE=reject

# Embedder for similar-ticket retrieval: "bow" (hashed bag-of-words, offline,
# default) or "hf" (sentence-transformers MiniLM, 384-dim, lazy-loaded).
# Vectors record their producer, so switching this recomputes what it must.
# AI_EMBED_PROVIDER=bow

# Knowledge base RAG vector store: "llama_index" (in-process, default) or
# "qdrant" (falls back to llama_index when unreachable).
# AI_VECTOR_STORE=llama_index
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=support_kb
# QDRANT_PATH=            # embedded on-disk path (no server needed)

# Cloudflare Workers AI (docs: https://developers.cloudflare.com/workers-ai/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# OpenAI-compatible alternative
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Monthly AI spend cap in USD — a hard stop checked before every paid provider
# call, summed from ai_call_traces for the current calendar month (UTC).
#   > 0   reaching the cap refuses paid calls with 429 until the month rolls over
#   <= 0  cap disabled (explicit opt-out)
# Local providers (stub, distilbert) are free and are never capped.
# Approved budget: $10/project/month — docs/DECISIONS.md D5/D8.
# AI_MONTHLY_BUDGET_USD=10

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=800

# OpenTelemetry GenAI tracing. Off by default: the durable ai_call_traces
# table and the in-process counters work regardless. Point at any OTLP
# collector (Langfuse, Tempo, Honeycomb) to get spans.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=supportdesk-ai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Durable workflows (Temporal). Off by default so dev and tests need no
# Temporal server; the in-process runner executes the same activities.
# TEMPORAL_ENABLED=false
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=supportdesk
# WORKFLOW_STAGE_TIMEOUT_S=120

# Distributed rate limiting for guest (anonymous) ticket submissions.
# Empty (default): the limiter is in-process — one instance, no extra service.
# Set: the per-IP counter moves into Redis, so every worker/replica behind the
# ingress shares one allowance. The limiter falls back to in-process if Redis
# is unreachable, so this is never a dependency of a request succeeding.
# REDIS_URL=redis://localhost:6379/0
# UPSTASH_REDIS_URL=        # alias accepted for Upstash serverless Redis
# REDIS_CONNECT_TIMEOUT_S=0.5

# Rate limit on guest (anonymous, no account) ticket submissions per peer IP.
# Set the limit to 0 to disable. Authenticated submitters are not counted.
# TICKET_CREATE_RATE_LIMIT=10
# TICKET_CREATE_RATE_WINDOW_S=3600

# Agent tool-calling loop guard rail (max steps per run).
# TOOL_MAX_STEPS=6

# Pin Postgres to IPv4 (for networks without IPv6 routing, e.g. kind).
# DB_PREFER_IPV4=false

# Email provider (stub | log | smtp)
EMAIL_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_TIMEOUT_S=5
