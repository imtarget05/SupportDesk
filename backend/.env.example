# Copy to .env and fill in. NEVER commit the real .env.
# AI provider: "stub" (offline, default) | "cloudflare" (Workers AI) |
#               "openai" | "anthropic" (Claude)
AI_PROVIDER=stub

# Auth: REQUIRED, min 32 chars. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# docker-compose.yml fails fast if JWT_SECRET is unset (no dev default).
# JWT_SECRET=change-me-to-a-32-plus-char-secret

# Guardrail on unsafe AI output: "reject" (return 502, keep ticket) or
# "fallback" (return a neutral draft instead of the blocked one).
# AI_GUARDRAIL_MODE=reject

# Embedder for similar-ticket retrieval: "bow" (hashed bag-of-words, offline,
# default) or "hf" (sentence-transformers MiniLM, 384-dim, lazy-loaded).
# Vectors record their producer, so switching this recomputes what it must.
# AI_EMBED_PROVIDER=bow

# Knowledge base RAG vector store: "llama_index" (in-process, default) or
# "qdrant" (falls back to llama_index when unreachable).
# AI_VECTOR_STORE=llama_index
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=support_kb
# QDRANT_PATH=            # embedded on-disk path (no server needed)

# Cloudflare Workers AI (docs: https://developers.cloudflare.com/workers-ai/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# OpenAI-compatible alternative
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=800

# OpenTelemetry GenAI tracing. Off by default: the durable ai_call_traces
# table and the in-process counters work regardless. Point at any OTLP
# collector (Langfuse, Tempo, Honeycomb) to get spans.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=supportdesk-ai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Durable workflows (Temporal). Off by default so dev and tests need no
# Temporal server; the in-process runner executes the same activities.
# TEMPORAL_ENABLED=false
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=supportdesk
# WORKFLOW_STAGE_TIMEOUT_S=120

# Agent tool-calling loop guard rail (max steps per run).
# TOOL_MAX_STEPS=6

# Email provider (stub | log | smtp)
EMAIL_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_TIMEOUT_S=5
